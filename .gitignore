# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# prisma — the client is generated on install (postinstall runs `prisma generate`)
/src/generated/

# typescript
*.tsbuildinfo
next-env.d.ts

# video — Cloudinary serves every reel (see config/clients.ts); Vercel uploads
# all of /public as static assets, so committing source footage here bloats the
# deployment until it fails. Keep the files on the CDN, keep the URL in config.
/public/**/*.mp4
/public/**/*.MP4
/public/**/*.mov
/public/**/*.MOV
